# FROM node:20.9.0

# WORKDIR /app

# COPY package.json yarn.lock ./

# RUN yarn install

# COPY . .

# RUN yarn build

# EXPOSE 3000

# CMD ["yarn", "start"]

FROM node:20.9.0-alpine

RUN apk update && \
    apk add --no-cache libreoffice

WORKDIR /app

COPY package.json yarn.lock ./

RUN yarn install

COPY . .

RUN yarn build

EXPOSE 3000

CMD ["yarn", "start"]