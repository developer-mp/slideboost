style.

  body {
  overflow-y: hidden;
  overflow-x: hidden;
  }

  .content {
  width: 100%; 
  padding: 1rem;
  }

  .code-box {
  background-color: #0ecfde;
  width: 50%;
  color: black;
  padding: 0.5rem;
  margin: 1rem 0;
  font-weight: bold;
  font-size: 1.5rem;
  text-align: center;
  border-radius: 5px;
  box-sizing: border-box;
  }

  .code-icon {
  display: block;
  margin-bottom: 1rem;
  width: 50px;
  height: auto;
  margin-left: auto;
  margin-right: auto;
  }

  .button{
  background-color: #2e6930;
  border-radius: 0.5em;
  width: 80px;
  border: 4px #ffffff;
  color: #ffffff;
  padding: 0.5em;
  cursor: pointer;
  }

  .footer {
  font-size: 0.8rem; 
  padding: 1rem; 
  margin-top: 1rem;
  }